# Copy this file to `.env` and fill in your keys.
# .env is gitignored — never commit real credentials.

# Cohere — used for embed-v4.0 (primary embedding model)
COHERE_API_KEY=

# OpenAI — used by some notebooks for question generation / LLM-judge steps
OPENAI_API_KEY=

# OpenRouter — alternative embedding/LLM provider (optional)
OPENROUTER_API_KEY=

# Optional overrides — leave unset to use defaults from scripts/config.py
# PROJECT_BASE_DIR=
# DATA_DIR=
