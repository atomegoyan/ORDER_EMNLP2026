# ── ORDER-specific data artefacts (large / regenerable) ─────────────────
# Chunked corpora (regenerated by scripts/chunk_debats + generate_all_chunk_variants)
data/corpus_1887_splitted_*/
data/corpus_1887_section*/

# Embeddings (ChromaDB stores — multi-GB, regenerated by embed_chunk_variants / build_indexes)
data/embeddings_*/
data/legaulois_1887*/
data/lintransigeant_1887*/
data/lepetitparisien_1887*/
data/debattre_1887*/

# BM25 indices (regenerated by build_indexes.py)
data/bm25_*/

# Pre-computed retrieval caches (regenerated by run_C2/C3/C4)
data/RETRIEVER_results_*/
data/METADATA_results_*/
data/RAG_results/
data/retrieval/
data/multiseed_results/

# SOTA outputs
data/hipprag_output/
data/hipprag_mh_output/
data/linearrag_index/

# Question embeddings (regenerable; keep small JSONL files tracked manually if needed)
data/questions/embeddings/
data/questions_singlehop/

# Trained classifiers / models
*.joblib
*.pkl
*.pickle

# ── Paper build artefacts ───────────────────────────────────────────────
paper_EMNLP/latex/*.aux
paper_EMNLP/latex/*.log
paper_EMNLP/latex/*.out
paper_EMNLP/latex/*.bbl
paper_EMNLP/latex/*.blg
paper_EMNLP/latex/*.toc
paper_EMNLP/latex/*.synctex.gz
paper_EMNLP/latex/*.fdb_latexmk
paper_EMNLP/latex/*.fls
paper_EMNLP/latex/*.pdf

